{
  "name": "interview-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file=.env.local --conditions=react-server scripts/seed.ts",
    "smoke:voice": "tsx --env-file=.env.local --conditions=react-server scripts/smoke-voice.ts",
    "smoke:brain": "tsx --env-file=.env.local --conditions=react-server scripts/smoke-brain.ts",
    "smoke:interview": "tsx --env-file=.env.local --conditions=react-server scripts/smoke-interview.ts",
    "smoke:privacy": "tsx --env-file=.env.local --conditions=react-server scripts/smoke-privacy.ts",
    "smoke": "npm run smoke:voice && npm run smoke:brain && npm run smoke:interview && npm run smoke:privacy"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "groq-sdk": "^1.6.0",
    "linkedom": "^0.18.13",
    "mammoth": "^1.12.3",
    "mongodb": "^7.6.0",
    "motion": "^13.3.0",
    "next": "^15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "vitest": "^5.0.1"
  }
}
