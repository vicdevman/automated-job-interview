# ── core ───────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=interview_sim
# openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# 32-byte base64 — AES-256-GCM field encryption (PRD §8.1)
ENCRYPTION_KEY=

# ── provider selection: the swap surface (PRD §3.2) ─────────────────────
STT_PROVIDER=speechmatics
NEXT_PUBLIC_STT_PROVIDER=speechmatics
STT_BATCH_PROVIDER=whisper
TTS_PROVIDER=speechmatics
LLM_PROVIDER=groq
SEARCH_PROVIDER=tavily
SCRAPE_PROVIDER=readability

# ── speechmatics (one key covers STT + TTS) ─────────────────────────────
SPEECHMATICS_API_KEY=
SPEECHMATICS_RT_URL=wss://global.rt.speechmatics.com/v2
SPEECHMATICS_MP_URL=https://mp.speechmatics.com/v1
SPEECHMATICS_TTS_URL=https://preview.tts.speechmatics.com
SPEECHMATICS_TTS_VOICE=theo

# ── llm ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# second adapter, proves the abstraction (PRD §3.2 acceptance test)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── search ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── tuning ──────────────────────────────────────────────────────────────
STT_TOKEN_TTL_SECONDS=300
INTERVIEW_QUESTION_COUNT=6
MAX_UPLOAD_BYTES=10485760
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MAX_BYTES=2000000
RETENTION_DAYS=90

# ── seeded interviewer account (PRD §1.2) ───────────────────────────────
SEED_INTERVIEWER_EMAIL=
SEED_INTERVIEWER_PASSWORD=

# set by Vercel Cron; without it /api/cron/purge is disabled
CRON_SECRET=

# ── turn timing: how patient the interviewer is (lib/interview/turn-timing.ts) ──
# These are inlined at BUILD time, so restart `npm run dev` after changing them.
# Total wait before auto-submit = END_OF_UTTERANCE_SILENCE + TURN_GRACE_MS
NEXT_PUBLIC_END_OF_UTTERANCE_SILENCE=2
NEXT_PUBLIC_TURN_GRACE_MS=1500
NEXT_PUBLIC_MIN_ANSWER_WORDS=8
NEXT_PUBLIC_MIN_ANSWER_MS=3000
NEXT_PUBLIC_STT_MAX_DELAY=1
