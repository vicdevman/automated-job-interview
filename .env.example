# ── core ───────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=interview_sim
# openssl rand -base64 32   (or: node -e "console.log(crypto.randomBytes(32).toString('base64'))")
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Required whenever the app is served from a host Auth.js cannot infer.
# Vercel sets this implicitly; `next start` locally and any other host do not.
AUTH_TRUST_HOST=true
# 32-byte base64 — AES-256-GCM field encryption (PRD §8.1)
ENCRYPTION_KEY=

# ── provider selection: the swap surface (PRD §3.2) ─────────────────────
STT_PROVIDER=speechmatics
NEXT_PUBLIC_STT_PROVIDER=speechmatics
STT_BATCH_PROVIDER=whisper
TTS_PROVIDER=speechmatics
LLM_PROVIDER=groq
SEARCH_PROVIDER=tavily
SCRAPE_PROVIDER=readability

# ── speechmatics (one key covers STT + TTS) ─────────────────────────────
SPEECHMATICS_API_KEY=
SPEECHMATICS_RT_URL=wss://global.rt.speechmatics.com/v2
SPEECHMATICS_MP_URL=https://mp.speechmatics.com/v1
SPEECHMATICS_TTS_URL=https://preview.tts.speechmatics.com
SPEECHMATICS_TTS_VOICE=theo

# ── llm ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# second adapter, proves the abstraction (PRD §3.2 acceptance test)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── search ──────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── tuning ──────────────────────────────────────────────────────────────
STT_TOKEN_TTL_SECONDS=300
INTERVIEW_QUESTION_COUNT=6
MAX_UPLOAD_BYTES=10485760
SCRAPE_TIMEOUT_MS=10000
SCRAPE_MAX_BYTES=2000000
RETENTION_DAYS=90

# ── seeded interviewer account (PRD §1.2) ───────────────────────────────
SEED_INTERVIEWER_EMAIL=
SEED_INTERVIEWER_PASSWORD=

# set by Vercel Cron; without it /api/cron/purge is disabled
CRON_SECRET=

# ── turn timing: how patient the interviewer is (lib/interview/turn-timing.ts) ──
# These control how long the interviewer waits after you stop talking before it
# treats your answer as finished and submits it automatically.
#
# IMPORTANT: these are read into the browser bundle at BUILD time (that's what
# NEXT_PUBLIC_ means), so after changing any value here you must restart
# `npm run dev` — reloading the page in the browser is not enough.

# How many seconds of silence the SPEECH-TO-TEXT SERVICE itself waits before it
# decides you've finished talking. Measured in seconds. Default: 2.
# Raise this if it cuts you off mid-sentence too often; lower it if it takes too
# long to notice you've stopped. The service itself will not accept a value
# above 2 — if you need more patience than that, use TURN_GRACE_MS below.
NEXT_PUBLIC_END_OF_UTTERANCE_SILENCE=2

# Extra time WE wait, on top of the above, before actually sending your answer
# off to be scored. Measured in milliseconds (1000 = 1 second). Default: 1500
# (1.5s). If you start talking again during this window, the wait is cancelled
# and you just keep answering — so raising this costs nothing for someone who
# talks confidently, it only helps someone who paused to think.
# Total wait before auto-submit = END_OF_UTTERANCE_SILENCE + TURN_GRACE_MS
#                                = 2s + 1.5s = 3.5s by default.
NEXT_PUBLIC_TURN_GRACE_MS=1500

# The hard safety net. If the speech-to-text service's own "you've stopped
# talking" signal never arrives at all (a dropped connection, a provider
# glitch — anything), this is the absolute longest we wait, measured from the
# last word it heard, before submitting your answer anyway. Measured in
# milliseconds. Default: 6000 (6 seconds). This should always be noticeably
# bigger than the total wait above, so in normal use it never actually fires
# first — it only matters when the normal path has already failed.
NEXT_PUBLIC_FALLBACK_SILENCE_MS=6000

# The shortest answer (by word count) that is ever auto-submitted. Below this,
# a pause is treated as noise (a stray "um") rather than a finished answer, and
# is ignored. Measured in whole words. Default: 2 — keep this LOW. It used to
# be 8, which was the actual cause of a real bug: most real answers have their
# very first pause land under 8 words, so auto-submit silently never fired and
# you had to click "Done answering" every single time.
NEXT_PUBLIC_MIN_ANSWER_WORDS=2

# How long the speech-to-text service is allowed to hold onto audio before it
# gives us back a confirmed (non-changing) line of text. Measured in seconds.
# Default: 1. Higher is slightly more accurate but makes the live captions lag
# further behind your actual voice; the service requires a value between 0.7
# and 4.
NEXT_PUBLIC_STT_MAX_DELAY=1
